# 复制为 .env 后按需取消注释；不建 .env 也能直接 ./scripts/up.sh。

# 0. 部署模式（可选；设为 cn 后运行 ./scripts/up.sh 会自动走 --cn 国内构建加速模式）
# DEPLOY_MODE=cn

# 1. 容器镜像加速（二选一，适合国内云服务器；若用 ./scripts/up.sh --cn 会自动设置 BOT_IMAGE=echo-bot:cn）
# 方式 A：只替换 GHCR 镜像站域名（如 ghcr.nju.edu.cn / ghcr.m.daocloud.io）
# IMAGE_REGISTRY=ghcr.nju.edu.cn
# 方式 B：指定完整自定义镜像地址（例如个人阿里云 ACR 仓库或本地构建镜像）
# BOT_IMAGE=crpi-xxxxxxxx.cn-hangzhou.personal.cr.aliyuncs.com/your-ns/echo-bot:latest

# 本地构建加速参数（./scripts/up.sh --cn 或 --build 时使用）
# BASE_IMAGE=soulter/astrbot:v4.29.4
# APT_MIRROR=http://mirrors.cloud.tencent.com
# PIP_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple

# 2. GitHub 资源下载加速（仅作用于首次启动拉取 NapCat 与 link_resolver，仅支持 https://）
# 下载后会自动校验 SHA256 与压缩包结构，失败时自动回退直连 GitHub
# GITHUB_PROXY=https://gh-proxy.org

# 可选自定义下载源与校验值（一般保持默认即可）
# QQ_DEB_AMD64=
# QQ_DEB_ARM64=
# QQ_DEB_SHA256=
# NAPCAT_ZIP_URL=
# NAPCAT_ZIP_SHA256=
# LINK_RESOLVER_URL=
# LINK_RESOLVER_SHA256=

# 3. 容器出口代理（用于 bootstrap、AstrBot 与 Codex；QQ 客户端强制直连不走代理）
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=127.0.0.1,localhost,::1

# 4. 容器端口、名称与机器人凭证
# BIND_HOST=127.0.0.1
# PANEL_PORT=6185
# NAPCAT_PORT=6099
# CONTAINER_NAME=echo-bot
# TZ=Asia/Shanghai
# BOT_QQ=
# ONEBOT_TOKEN=（留空自动生成 32 字节随机密钥并持久化）
# NAPCAT_WEBUI_TOKEN=
