# 想改默认值就复制成 .env。不建 .env 也能直接 ./scripts/up.sh

# 镜像，默认用 Actions 构建好的最新版
BOT_IMAGE=ghcr.io/wendadawen/echo-bot:latest

# 三个端口（宿主机侧）：面板 / 反向 WS / 扫码页
PANEL_PORT=6185
ONEBOT_PORT=6199
NAPCAT_PORT=6099

CONTAINER_NAME=echo-bot
TZ=Asia/Shanghai

# 机器人 QQ 号，填了会多生成一份对应账号的配置
BOT_QQ=
# 反向 WS 令牌，留空即不校验；两边会自动保持一致
ONEBOT_TOKEN=
# 扫码页令牌，留空则由 NapCat 自己生成
NAPCAT_WEBUI_TOKEN=

# 官方下载链接失效时，在这里覆盖（按 CPU 架构选一个）
QQ_DEB_AMD64=
QQ_DEB_ARM64=
NAPCAT_ZIP_URL=
